# Proxy interno exclusivo do RH151. Nenhum valor real de domínio é armazenado aqui.
server {
    listen 8080;
    server_name _;
    access_log off;
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 30s;
    send_timeout 30s;

    set_real_ip_from @@TRAEFIK_NETWORK_CIDR@@;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /rh151 { return 404; }

    location ^~ /rh151/ {
        rewrite ^/rh151(/.*)$ $1 break;
        proxy_pass http://unix:/run/zeluz-rh151/api.sock;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-RH-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Cookie "";
        proxy_set_header Connection "";
        proxy_hide_header Server;
    }

    location / { return 404; }
}
